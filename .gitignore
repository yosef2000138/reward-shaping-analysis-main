# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
# `env/` is application source in this repository and must remain tracked.
.venv/
venv/

# Test, coverage, and tool caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.hypothesis/
.ipynb_checkpoints/

# Packaging and build output
build/
dist/
*.egg-info/
.eggs/

# Local configuration and secrets
.env
.env.*
!.env.example
*.local

# IDE and operating-system files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Logs and temporary files
*.log
*.tmp
*.temp

# LaTeX intermediate files; keep report.tex and the final PDF
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
